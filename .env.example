# VigilOne Environment Configuration Template
# NOTE: Never commit production credentials to version control.

# Deployment Environment: development | production
NODE_ENV=development

# Edge Appliance Gateway & Network
PORT=4000
LAN_IP=127.0.0.1
MANAGEMENT_IP=127.0.0.1

# Internal MediaMTX Hook Shared Secret (Must be 32+ characters in production)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=CHANGE_ME_GENERATE_RANDOM_HEX32

# Database Configuration (PostgreSQL)
POSTGRES_USER=vigilone
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=vigilone_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Security & JWT Tokens
# Minimum 32 characters string for signing operator JWTs & short-lived media tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_JWT_SECRET_32_CHARS_MIN

# Credential Encryption Key (AES-256-GCM, 32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
# In production, this key must be persisted at /etc/vigilone/appliance.key (chmod 600)
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_GENERATE_BASE64_ENCODED_32_BYTES

# MediaMTX Internal Control API URL (Strictly internal Docker network)
MEDIAMTX_API_URL=http://mediamtx:9997

# Storage & Directory Paths
RECORDINGS_DIR=/recordings
EXPORTS_DIR=/recordings/exports

# Recording Configuration
# Development default: 30s segments for fast testing loops
# Production default: 10m segments
RECORD_SEGMENT_DURATION=10m
RECORD_PART_DURATION=1s

# Initial Super Admin Provisioning Token (Used only during initial POST /api/v1/auth/bootstrap)
# Generate with: openssl rand -hex 16
SETUP_TOKEN=CHANGE_ME_ONE_TIME_SETUP_BOOTSTRAP_TOKEN

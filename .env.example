# VigilOne Environment Configuration

# Deployment Environment: development | production
NODE_ENV=development

# Edge Appliance Gateway & Network
PORT=4000
LAN_IP=127.0.0.1

# Database Configuration (PostgreSQL)
POSTGRES_USER=vigilone
POSTGRES_PASSWORD=vigilone_dev_secret_2026
POSTGRES_DB=vigilone_db
DATABASE_URL=postgresql://vigilone:vigilone_dev_secret_2026@postgres:5432/vigilone_db?schema=public

# Security & JWT Tokens
# Minimum 32 bytes string for signing operator JWTs & short-lived media tokens
JWT_SECRET=vigilone_dev_jwt_signing_key_32bytes_min!

# Credential Encryption Key (AES-256-GCM, 32 bytes base64 encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production, this key is stored in /etc/vigilone/appliance.key (chmod 600)
CREDENTIAL_ENCRYPTION_KEY=eGlhOHBqa2w4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# MediaMTX Internal Control API URL
MEDIAMTX_API_URL=http://mediamtx:9997

# Storage & Directory Paths
RECORDINGS_DIR=/recordings
EXPORTS_DIR=/recordings/exports

# Recording Configuration
# Development default: 30s segments for fast automated test loops
# Production default: 10m segments
RECORD_SEGMENT_DURATION=30s
RECORD_PART_DURATION=1s

# Initial Super Admin Provisioning (Used during POST /api/v1/auth/bootstrap)
SETUP_TOKEN=vigilone_dev_setup_token_99182

#!/usr/bin/env bash
# ==============================================================================
# VigilOne VMS - Commercial Appliance Management CLI (vigilonectl)
# ==============================================================================

set -euo pipefail

# Overridable for tests (scripts/__tests__/backup-restore.test.sh); the appliance uses the defaults.
INSTALL_DIR="${VIGILONE_INSTALL_DIR:-/opt/vigilone}"
CONFIG_DIR="${VIGILONE_CONFIG_DIR:-/etc/vigilone}"
DATA_DIR="${VIGILONE_DATA_DIR:-/var/lib/vigilone}"
RECORDINGS_DIR="${DATA_DIR}/recordings"
POSTGRES_DIR="${DATA_DIR}/postgres"

RED="[0;31m"
GREEN="[0;32m"
YELLOW="[1;33m"
BLUE="[0;34m"
CYAN="[0;36m"
NC="[0m"

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_err() { echo -e "${RED}[ERROR]${NC} $1" >&2; }
fatal() { log_err "$1"; exit 1; }

usage() {
    echo -e "${BLUE}VigilOne Appliance Control (vigilonectl)${NC}"
    echo "Usage: vigilonectl <command> [options]"
    echo ""
    echo "Commands:"
    echo "  status               Display appliance telemetry, health, and storage vitals"
    echo "  token                Display initial setup token if bootstrap is pending"
    echo "  logs [options]       View formatted container service logs (-f for follow)"
    echo "  restart [service]    Restart appliance containers or a specific service"
    echo "  update               Pull pinned releases, apply DB migrations, with rollback safety"
    echo "  ota <action>         Manage signed OTA update bundles (apply, rollback, status)"
    echo "  backup <action>      Manage atomic appliance backups (create, restore)"
    echo "  support-bundle       Generate a sanitized diagnostics archive for technical support"
    echo "  acceptance [zip]     Run the automatable installation acceptance checks; lists manual items"
    echo "  golive [--json]      Go-live readiness: BLOCK / WARN / MANUAL / PASS per item (exit 1 when blocked)"
    echo "  reset-factory        Factory reset database and appliance state (destructive)"
    echo "  version              Display VigilOne software and appliance version"
    echo "  help                 Display this help menu"
    echo ""
}

cmd_status() {
    echo -e "${CYAN}================================================================================${NC}"
    echo -e "${CYAN}                  VigilOne NVR Appliance - System Status                        ${NC}"
    echo -e "${CYAN}================================================================================${NC}"

    # 1. Host Vitals
    UPTIME_STR="$(uptime 2>/dev/null || echo "N/A")"
    echo -e "${BLUE}[Host Telemetry]${NC}"
    echo "  Uptime: ${UPTIME_STR}"
    echo "  Load Average: $(awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null || echo "N/A")"
    MEM_TOTAL="$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{printf "%.1f GB", $2/1024/1024}' || echo "N/A")"
    MEM_FREE="$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{printf "%.1f GB", $2/1024/1024}' || echo "N/A")"
    echo "  Memory: ${MEM_FREE} free / ${MEM_TOTAL} total"
    echo ""

    # 2. Container Status
    echo -e "${BLUE}[Container Matrix]${NC}"
    if command -v docker &>/dev/null; then
        cd "${INSTALL_DIR}" 2>/dev/null || true
        docker compose ps --format "table {{.Name}}	{{.Status}}	{{.Health}}" 2>/dev/null || echo "  Docker compose stack not reachable."
    else
        echo "  Docker is not installed or accessible."
    fi
    echo ""

    # 3. Storage & Mount Guard Status
    echo -e "${BLUE}[Storage & Mount Guard]${NC}"
    PROBE_FILE="${RECORDINGS_DIR}/.vigilone-mount-probe"
    if [[ -f "$PROBE_FILE" ]]; then
        echo -e "  Mount Guard: ${GREEN}OK (Probe verified at ${RECORDINGS_DIR})${NC}"
    else
        echo -e "  Mount Guard: ${RED}DEGRADED / PROBE MISSING (${RECORDINGS_DIR})${NC}"
    fi

    if [[ -d "${RECORDINGS_DIR}" ]]; then
        DISK_USAGE="$(df -h "${RECORDINGS_DIR}" 2>/dev/null | tail -n 1 | awk '{print $3 " used / " $2 " (" $5 " used, " $4 " free)"}' || echo "N/A")"
        echo "  CCTV Storage Pool: ${DISK_USAGE}"
    fi
    echo ""

    # 4. Bootstrap Status
    echo -e "${BLUE}[Provisioning State]${NC}"
    STATUS_JSON="$(curl -k -s --max-time 2 https://127.0.0.1/api/v1/auth/bootstrap/status 2>/dev/null || echo "{}")"
    IS_BOOTSTRAPPED="$(echo "$STATUS_JSON" | grep -o '"isBootstrapped":true' || true)"
    if [[ -n "$IS_BOOTSTRAPPED" ]]; then
        echo -e "  Appliance State: ${GREEN}INITIALIZED / ACTIVE${NC} (Bootstrap locked)"
    else
        echo -e "  Appliance State: ${YELLOW}UNINITIALIZED (First-Run Setup Pending)${NC}"
        echo -e "  Run '${CYAN}vigilonectl token${NC}' to view technician setup PIN."
    fi
    echo -e "${CYAN}================================================================================${NC}"
}

cmd_token() {
    TOKEN_FILE="${CONFIG_DIR}/setup-token.txt"

    # Check if already bootstrapped
    STATUS_JSON="$(curl -k -s --max-time 2 https://127.0.0.1/api/v1/auth/bootstrap/status 2>/dev/null || echo "{}")"
    if echo "$STATUS_JSON" | grep -q '"isBootstrapped":true'; then
        log_info "Appliance is already initialized. First-run bootstrap is permanently disabled (410 Gone)."
        exit 0
    fi

    if [[ -f "$TOKEN_FILE" ]]; then
        TOKEN="$(cat "$TOKEN_FILE" | tr -d '

')"
        echo -e "${YELLOW}================================================================================${NC}"
        echo -e "  VigilOne Initial Setup PIN: ${GREEN}${TOKEN}${NC}"
        echo -e "${YELLOW}================================================================================${NC}"
        echo "Enter this PIN in the browser at https://vigilone.local to initialize the appliance."
    else
        log_err "Setup token file not found at ${TOKEN_FILE}."
        exit 1
    fi
}

cmd_logs() {
    cd "${INSTALL_DIR}" 2>/dev/null || fatal "Install directory ${INSTALL_DIR} not found."
    docker compose logs "$@"
}

cmd_restart() {
    cd "${INSTALL_DIR}" 2>/dev/null || fatal "Install directory ${INSTALL_DIR} not found."
    log_info "Restarting appliance services..."
    docker compose restart "$@"
    log_info "Restart complete."
}

cmd_update() {
    local BUNDLE="${1:-}"
    if [[ -z "$BUNDLE" ]]; then
        echo -e "${YELLOW}VigilOne Appliance Update requires a cryptographically signed OTA bundle (.tar.gz).${NC}"
        echo "Usage: vigilonectl update <path-to-bundle.tar.gz> (or: vigilonectl ota apply <path-to-bundle.tar.gz>)"
        echo ""
        echo "To inspect current release version and epoch: vigilonectl ota status"
        exit 1
    fi

    log_info "Initiating cryptographic OTA appliance update: $BUNDLE"
    cmd_ota apply "$BUNDLE"
}

cmd_support_bundle() {
    log_info "Generating sanitized diagnostics support bundle..."

    TMP_DIR="$(mktemp -d /tmp/vigilone-support-XXXXXX)"
    BUNDLE_NAME="vigilone-support-$(date +%Y%m%d-%H%M%S).tar.gz"
    OUT_FILE="${1:-$(pwd)/${BUNDLE_NAME}}"

    mkdir -p "${TMP_DIR}/system"
    mkdir -p "${TMP_DIR}/docker"
    mkdir -p "${TMP_DIR}/logs"
    mkdir -p "${TMP_DIR}/storage"

    # 1. System specs (sanitized)
    uname -a > "${TMP_DIR}/system/uname.txt" 2>/dev/null || true
    cat /etc/os-release > "${TMP_DIR}/system/os-release.txt" 2>/dev/null || true
    uptime > "${TMP_DIR}/system/uptime.txt" 2>/dev/null || true
    df -h > "${TMP_DIR}/storage/df.txt" 2>/dev/null || true
    lsblk > "${TMP_DIR}/storage/lsblk.txt" 2>/dev/null || true

    # 2. Docker inspect & ps
    if command -v docker &>/dev/null; then
        cd "${INSTALL_DIR}" 2>/dev/null || true
        docker compose ps > "${TMP_DIR}/docker/compose-ps.txt" 2>/dev/null || true
        docker ps --all > "${TMP_DIR}/docker/docker-ps.txt" 2>/dev/null || true
        # Tail last 500 lines of logs
        docker compose logs --tail=500 > "${TMP_DIR}/logs/container-logs.txt" 2>/dev/null || true
    fi

    # 3. Privacy Sanitizer Filter (Mandatory Contract Requirement)
    log_info "Sanitizing sensitive tokens, credentials, and passwords..."
    find "${TMP_DIR}" -type f | while read -r f; do
        # Strip JWTs (eyJ...)
        sed -i.bak -E 's/eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/[SANITIZED_JWT]/g' "$f" 2>/dev/null || true
        # Strip Bearer tokens
        sed -i.bak -E 's/Bearer [A-Za-z0-9_.-]{8,}/Bearer [SANITIZED_TOKEN]/g' "$f" 2>/dev/null || true
        # Strip Authorization headers
        sed -i.bak -E 's/Authorization: [^
]+/Authorization: [SANITIZED]/gI' "$f" 2>/dev/null || true
        # Strip postgres connection URLs with passwords
        sed -i.bak -E 's/postgresql:\/\/([^:]+):([^@]+)@/postgresql:\/\/:[SANITIZED]@/g' "$f" 2>/dev/null || true
        # Strip RTSP URLs with credentials
        sed -i.bak -E 's/rtsp:\/\/([^:]+):([^@]+)@/rtsp:\/\/:[SANITIZED]@/g' "$f" 2>/dev/null || true
        # Strip base64 keys and setup tokens
        sed -i.bak -E 's/SETUP_TOKEN=[^
]+/SETUP_TOKEN=[SANITIZED]/g' "$f" 2>/dev/null || true
        sed -i.bak -E 's/JWT_SECRET=[^
]+/JWT_SECRET=[SANITIZED]/g' "$f" 2>/dev/null || true
        sed -i.bak -E 's/INTERNAL_API_SECRET=[^
]+/INTERNAL_API_SECRET=[SANITIZED]/g' "$f" 2>/dev/null || true
        sed -i.bak -E 's/POSTGRES_PASSWORD=[^
]+/POSTGRES_PASSWORD=[SANITIZED]/g' "$f" 2>/dev/null || true
        sed -i.bak -E 's/COTURN_SECRET=[^
]+/COTURN_SECRET=[SANITIZED]/g' "$f" 2>/dev/null || true
        sed -i.bak -E 's/CREDENTIAL_ENCRYPTION_KEY=[^
]+/CREDENTIAL_ENCRYPTION_KEY=[SANITIZED]/g' "$f" 2>/dev/null || true
        # Remove backup files
        rm -f "${f}.bak"
    done

    # 4. Create compressed tarball archive
    tar -czf "${OUT_FILE}" -C "${TMP_DIR}" .
    rm -rf "${TMP_DIR}"

    log_info "Sanitized support bundle generated at: ${OUT_FILE}"
}

cmd_reset_factory() {
    echo -e "${RED}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}"
    echo -e "${RED}                   VIGILONE FACTORY RESET - DESTRUCTIVE ACTION                 ${NC}"
    echo -e "${RED}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}"
    echo "This operation will wipe the appliance database, delete all users and configurations."
    echo ""
    read -r -p "Type 'YES-RESET-APPLIANCE' to confirm factory reset: " CONFIRM
    if [[ "$CONFIRM" != "YES-RESET-APPLIANCE" ]]; then
        fatal "Factory reset cancelled."
    fi

    WIPE_RECORDINGS=false
    read -r -p "Do you also wish to WIPE all recorded video footage? (y/N): " WIPE_INPUT
    if [[ "$WIPE_INPUT" == "y" || "$WIPE_INPUT" == "Y" ]]; then
        WIPE_RECORDINGS=true
    fi

    log_info "Stopping appliance services..."
    cd "${INSTALL_DIR}" 2>/dev/null || true
    docker compose down 2>/dev/null || true

    log_info "Wiping database volume..."
    rm -rf "${POSTGRES_DIR}"/* 2>/dev/null || true

    if [[ "$WIPE_RECORDINGS" == "true" ]]; then
        log_info "Wiping CCTV video recordings..."
        rm -rf "${RECORDINGS_DIR}"/* 2>/dev/null || true
        # Re-plant Mount Guard probe
        echo "VIGILONE_MOUNT_GUARD_OK_$(date -u +%Y%m%d%H%M%S)" > "${RECORDINGS_DIR}/.vigilone-mount-probe"
    fi

    # Reset bootstrap token
    NEW_TOKEN="$(openssl rand -hex 16 2>/dev/null || echo "reset_token_$(date +%s)")"
    echo "$NEW_TOKEN" > "${CONFIG_DIR}/setup-token.txt" 2>/dev/null || true

    log_info "Restarting appliance stack..."
    docker compose up -d 2>/dev/null || true

    log_info "Factory reset complete. New Setup PIN: ${NEW_TOKEN}"
}

# OTA runs in the backend container, which holds only compiled code (dist/) and production dependencies:
# snippets use node and require('./dist/...') (ts-node and src/ do not exist there), and files from the host are
# copied in first. Applying a full update this way has not been proven on a real appliance (GO_LIVE_RUNBOOK.md).
backend_node() {
    docker compose exec -T backend node -e "
      const { OtaUpdateService } = require('./dist/services/appliance/otaUpdate.service');
      const prisma = require('./dist/config/database').default;
      const ota = new OtaUpdateService(prisma);
      $1"
}

cmd_ota() {
    local SUB="${1:-status}"
    shift || true
    cd "${INSTALL_DIR}" || fatal "Install directory ${INSTALL_DIR} not found"
    case "$SUB" in
        apply)
            local BUNDLE="${1:-}"
            [[ -z "$BUNDLE" || ! -f "$BUNDLE" ]] && { log_err "Usage: vigilonectl ota apply <path-to-bundle.tar.gz>"; exit 1; }
            log_info "Applying signed OTA update: $BUNDLE"
            docker compose cp "$BUNDLE" backend:/tmp/vigilone-ota-bundle.tar.gz || fatal "Could not copy the bundle into the backend container."
            backend_node "ota.applyUpdate('/tmp/vigilone-ota-bundle.tar.gz').then((r) => { console.log(JSON.stringify(r, null, 2)); process.exit(r.success ? 0 : 1); }).catch((e) => { console.error(e.message); process.exit(1); });"
            ;;
        rollback)
            log_info "Rolling back to the pre-update snapshot..."
            backend_node "ota.triggerRollback().then((r) => { console.log(JSON.stringify(r, null, 2)); process.exit(r.success ? 0 : 1); }).catch((e) => { console.error(e.message); process.exit(1); });"
            ;;
        status)
            backend_node "console.log('Current Release Version:', ota.getCurrentVersion()); console.log('Release Epoch:', ota.getCurrentEpoch()); console.log('Rollback Available:', ota.hasRollbackSnapshot()); process.exit(0);" \
                || fatal "Could not read the OTA state (is the backend running? vigilonectl status)"
            ;;
        *)
            echo "Usage: vigilonectl ota <apply|rollback|status>"
            exit 1
            ;;
    esac
}

# Backups must never report success without a usable copy of the database: the dump is checked for
# pg_dump's completion marker, every file is listed in a SHA-256 manifest, and the archive is written under a
# temporary name and renamed only when complete. A restore checks the manifest first and loads the dump in ONE
# transaction (schema replaced and data loaded together), so a failed restore leaves the database as it was.
cmd_backup() {
    local SUB="${1:-create}"
    shift || true
    case "$SUB" in
        create)
            local OUT_DIR="${DATA_DIR}/backups"
            mkdir -p "$OUT_DIR"
            local OUT_FILE="${1:-${OUT_DIR}/vigilone-backup-$(date +%Y%m%d%H%M%S).tar.gz}"
            log_info "Creating appliance backup at ${OUT_FILE}..."
            local TMP_BACKUP
            TMP_BACKUP="$(mktemp -d /tmp/vigilone-backup-XXXXXX)"
            cd "${INSTALL_DIR}" || fatal "Install directory ${INSTALL_DIR} not found"

            if ! docker compose exec -T postgres pg_dump -U vigilone --no-owner vigilone_db > "${TMP_BACKUP}/database.sql"; then
                rm -rf "${TMP_BACKUP}"
                fatal "Database dump failed: NO backup was written. Is the postgres container running? (vigilonectl status)"
            fi
            if ! tail -n 5 "${TMP_BACKUP}/database.sql" | grep -q -- '-- PostgreSQL database dump complete'; then
                rm -rf "${TMP_BACKUP}"
                fatal "Database dump is incomplete (no completion marker): NO backup was written."
            fi

            # Appliance configuration, including the credential key: keep backups as secret as the appliance.
            if [[ -d "${CONFIG_DIR}" ]]; then
                cp -r "${CONFIG_DIR}" "${TMP_BACKUP}/config" || { rm -rf "${TMP_BACKUP}"; fatal "Copying ${CONFIG_DIR} failed: NO backup was written."; }
            else
                log_warn "${CONFIG_DIR} not found: the backup holds the database only (no credential key, licence or OTA state)."
            fi

            # The install's .env holds the secrets, possibly including CREDENTIAL_ENCRYPTION_KEY: without that key the
            # camera, S3 and SSO secrets in the database cannot be decrypted on another machine.
            if [[ -f "${INSTALL_DIR}/.env" ]]; then
                mkdir -p "${TMP_BACKUP}/install" && cp "${INSTALL_DIR}/.env" "${TMP_BACKUP}/install/.env" \
                    || { rm -rf "${TMP_BACKUP}"; fatal "Copying ${INSTALL_DIR}/.env failed: NO backup was written."; }
            fi

            (cd "${TMP_BACKUP}" && find . -type f ! -name MANIFEST.sha256 -print0 | sort -z | xargs -0 sha256sum > MANIFEST.sha256) \
                || { rm -rf "${TMP_BACKUP}"; fatal "Writing the backup manifest failed: NO backup was written."; }
            tar -czf "${OUT_FILE}.partial" -C "${TMP_BACKUP}" . || { rm -rf "${TMP_BACKUP}" "${OUT_FILE}.partial"; fatal "Writing the archive failed: NO backup was written."; }
            mv "${OUT_FILE}.partial" "${OUT_FILE}"
            rm -rf "${TMP_BACKUP}"
            chmod 600 "${OUT_FILE}"
            log_info "Backup created: ${OUT_FILE} ($(du -h "${OUT_FILE}" | cut -f1), $(tar -xzOf "${OUT_FILE}" ./database.sql | wc -l) lines of SQL)"
            log_warn "The backup contains the credential key. Store it as securely as the appliance itself."
            ;;
        restore)
            local ARCHIVE="${1:-}"
            [[ -z "$ARCHIVE" || ! -f "$ARCHIVE" ]] && { log_err "Usage: vigilonectl backup restore <path-to-backup.tar.gz>"; exit 1; }
            log_info "Restoring appliance from ${ARCHIVE}..."
            local TMP_RESTORE
            TMP_RESTORE="$(mktemp -d /tmp/vigilone-restore-XXXXXX)"
            tar -xzf "${ARCHIVE}" -C "${TMP_RESTORE}" || { rm -rf "${TMP_RESTORE}"; fatal "Cannot read ${ARCHIVE}: nothing was restored."; }
            if [[ -f "${TMP_RESTORE}/MANIFEST.sha256" ]]; then
                (cd "${TMP_RESTORE}" && sha256sum --quiet -c MANIFEST.sha256) || { rm -rf "${TMP_RESTORE}"; fatal "Backup archive is damaged or was altered (checksum mismatch): nothing was restored."; }
            else
                rm -rf "${TMP_RESTORE}"
                fatal "Backup has no MANIFEST.sha256 (made by an older vigilonectl): it cannot be verified, nothing was restored."
            fi
            [[ -f "${TMP_RESTORE}/database.sql" ]] || { rm -rf "${TMP_RESTORE}"; fatal "Backup has no database.sql: nothing was restored."; }

            cd "${INSTALL_DIR}" || fatal "Install directory ${INSTALL_DIR} not found"
            log_info "Stopping the backend so nothing writes during the restore..."
            docker compose stop backend || { rm -rf "${TMP_RESTORE}"; fatal "Could not stop the backend: nothing was restored."; }
            log_info "Restoring PostgreSQL (one transaction: the old data stays if anything fails)..."
            if ! docker compose exec -T postgres psql -U vigilone -d vigilone_db -q -v ON_ERROR_STOP=1 --single-transaction \
                    -c 'DROP SCHEMA public CASCADE' -c 'CREATE SCHEMA public' -f - < "${TMP_RESTORE}/database.sql" > /dev/null; then
                docker compose start backend || true
                rm -rf "${TMP_RESTORE}"
                fatal "Database restore FAILED and was rolled back: the database is unchanged."
            fi

            if [[ -d "${TMP_RESTORE}/config" ]]; then
                log_info "Restoring appliance configuration to ${CONFIG_DIR}..."
                mkdir -p "${CONFIG_DIR}"
                cp -a "${TMP_RESTORE}/config/." "${CONFIG_DIR}/" || { rm -rf "${TMP_RESTORE}"; fatal "Database restored, but copying the configuration to ${CONFIG_DIR} failed."; }
            fi

            # The current .env is kept (it belongs to this machine). If the backup's credential key differs, the restored
            # secrets cannot be decrypted: say so rather than let camera logins fail later.
            if [[ -f "${TMP_RESTORE}/install/.env" ]]; then
                local old_key new_key
                old_key="$(grep -E '^CREDENTIAL_ENCRYPTION_KEY=' "${TMP_RESTORE}/install/.env" | tail -n1 | cut -d= -f2- || true)"
                new_key="$(grep -E '^CREDENTIAL_ENCRYPTION_KEY=' "${INSTALL_DIR}/.env" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
                if [[ -n "$old_key" && "$old_key" != "$new_key" ]]; then
                    log_warn "The backup was made with a different CREDENTIAL_ENCRYPTION_KEY. Stored camera, S3 and SSO secrets will NOT decrypt"
                    log_warn "until ${INSTALL_DIR}/.env uses the backup's key (it is in the archive at install/.env)."
                fi
            fi

            docker compose start backend || { rm -rf "${TMP_RESTORE}"; fatal "Database restored, but the backend did not start: check vigilonectl logs backend."; }
            if [[ -d "${TMP_RESTORE}/config" ]]; then
                # Anti-rollback state (clock guard, pins, OTA floor) may only move forward.
                docker compose cp "${TMP_RESTORE}/config" backend:/tmp/vigilone-restore-config \
                    && docker compose exec -T backend node -e "
                      const { DisasterRecoveryService } = require('./dist/services/appliance/disasterRecovery.service');
                      const prisma = require('./dist/config/database').default;
                      new DisasterRecoveryService(prisma).restoreSecurityMonotonicState('/tmp/vigilone-restore-config')
                        .then((r) => { console.log(JSON.stringify(r)); process.exit(0); })
                        .catch((e) => { console.error(e.message); process.exit(1); });" \
                    || { rm -rf "${TMP_RESTORE}"; fatal "Database and configuration restored, but the anti-rollback state was NOT restored (see the error above)."; }
            fi
            rm -rf "${TMP_RESTORE}"
            log_info "Restore complete and verified. Run 'vigilonectl golive' to check the restored system."
            ;;
        *)
            echo "Usage: vigilonectl backup <create [out_file]|restore <backup.tar.gz>>"
            exit 1
            ;;
    esac
}

cmd_golive() {
    # docs/operations/GO_LIVE_RUNBOOK.md. The container cannot see the host clock's NTP state, so pass it in.
    local ntp="unknown"
    if command -v timedatectl >/dev/null 2>&1; then ntp="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo unknown)"; fi
    cd "${INSTALL_DIR}" || fatal "Install directory ${INSTALL_DIR} not found"
    docker compose exec -T -e VIGILONE_HOST_NTP_SYNC="${ntp}" backend node dist/ops/goLiveCheckCli.js "$@"
}

cmd_version() {
    echo "VigilOne NVR Appliance v1.0.0 (Commercial Edition)"
    echo "Architecture: $(uname -m)"
    echo "OS: $(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"' || uname -s)"
}

# ------------------------------------------------------------------------------
# Dispatcher
# ------------------------------------------------------------------------------
COMMAND="${1:-help}"
shift || true

cmd_acceptance() {
    # Automated items of docs/operations/INSTALLATION_ACCEPTANCE_CHECKLIST.md; manual items are
    # printed as MANUAL. Optional argument: path to an exported evidence package (F27-F29).
    local script="${INSTALL_DIR}/scripts/acceptance/acceptance.sh"
    [[ -x "$script" ]] || fatal "Acceptance tooling not installed at ${script} (re-run install.sh from a current release)"
    command -v node >/dev/null 2>&1 || log_warn "node is not installed on the host; report generation and evidence verification need Node >= 20"
    INSTALL_DIR="$INSTALL_DIR" CONFIG_DIR="$CONFIG_DIR" RECORDINGS_DIR="$RECORDINGS_DIR" \
        EVIDENCE_ZIP="${1:-}" RESULTS_DIR="${INSTALL_DIR}/acceptance-results" "$script"
}

case "$COMMAND" in
    status)          cmd_status "$@" ;;
    token)           cmd_token "$@" ;;
    logs)            cmd_logs "$@" ;;
    restart)         cmd_restart "$@" ;;
    update)          cmd_update "$@" ;;
    ota)             cmd_ota "$@" ;;
    backup)          cmd_backup "$@" ;;
    support-bundle)  cmd_support_bundle "$@" ;;
    acceptance)      cmd_acceptance "$@" ;;
    golive)          cmd_golive "$@" ;;
    reset-factory)   cmd_reset_factory "$@" ;;
    version)         cmd_version "$@" ;;
    help|--help|-h)  usage ;;
    *)               fatal "Unknown command: $COMMAND. Run 'vigilonectl help' for usage." ;;
esac

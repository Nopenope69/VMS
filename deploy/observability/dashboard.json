  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "VigilOne Edge Appliance Vitals & Storage Sovereignty",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Storage Volume Utilization",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "vigilone_storage_fill_ratio * 100",
          "legendFormat": "Storage Used %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Storage Free Capacity",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "vigilone_storage_bytes_free",
          "legendFormat": "Free Space"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 53687091200 },
              { "color": "green", "value": 107374182400 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Evidence Lease Pins",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "vigilone_evidence_active_pins_count",
          "legendFormat": "Active Pins"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Process Memory (RSS)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "vigilone_process_resident_memory_bytes",
          "legendFormat": "RSS Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 200,
      "title": "Video Ingestion & Worker Queue Health",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Camera Status Breakdown",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "vigilone_cameras_total",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "title": "Durable Segment Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "vigilone_segment_queue_depth{status=\"PENDING\"}",
          "legendFormat": "Pending Jobs"
        },
        {
          "expr": "vigilone_segment_queue_depth{status=\"PROCESSING\"}",
          "legendFormat": "Processing (Max 2)"
        },
        {
          "expr": "vigilone_segment_queue_depth{status=\"FAILED\"}",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recording Finalization Rate (Segments/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "rate(vigilone_recording_segments_total{status=\"FINALIZED\"}[5m]) * 60",
          "legendFormat": "Finalized Segments/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 300,
      "title": "Gateway Performance & Latency (RED Method)",
      "type": "row"
    },
    {
      "id": 8,
      "title": "API Request Throughput by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(vigilone_http_requests_total[5m])) by (status_class)",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 9,
      "title": "API P95 Response Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vigilone_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["vigilone", "vms", "edge", "cctv", "observability"],

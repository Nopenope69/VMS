{
    admin off
    servers {
        max_header_size 1MB
        timeouts {
            read_body 15s
            read_header 5s
            write 30s
            idle 60s
        }
    }
}

# HTTP Port 80: Permanent redirect to HTTPS (except internal health check)
:80 {
    log {
        output stdout
        format console
    }
    # Direct pass-through for health checks
    handle /api/v1/health {
        reverse_proxy backend:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
    redir https://{host}{uri} permanent
}

# HTTPS Port 443: Commercial edge TLS with Caddy internal CA
localhost, 127.0.0.1, vigilone.local, :443 {
    log {
        output stdout
        format console
    }

    tls internal

    request_body {
        max_size 10MB
    }

    # Root CA Certificate Download for Technician Onboarding
    handle /ca.crt {
        root * /data/caddy/pki/authorities/local
        rewrite * /root.crt
        file_server
    }

    # Block external access to internal webhook endpoints
    handle /api/v1/internal/* {
        respond "Forbidden: Internal Network Only" 403
    }

    # Block external access to metrics exposition
    handle /metrics* {
        respond "Forbidden: Internal Monitoring Only" 403
    }
    handle /api/v1/metrics* {
        respond "Forbidden: Internal Monitoring Only" 403
    }

    # WHEP WebRTC Signaling Proxy (Strips /whep prefix)
    # Browser calls: POST /whep/<streamPath>/whep
    # MediaMTX receives: POST /<streamPath>/whep
    handle_path /whep/* {
        reverse_proxy mediamtx:8889 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # HLS Streaming Proxy
    handle_path /hls/* {
        reverse_proxy mediamtx:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Backend REST API
    handle /api/* {
        reverse_proxy backend:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Static Frontend SPA
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}

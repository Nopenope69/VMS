import { validateModelManifest, isPermissiveLicense } from '../services/ai/modelManifest.service';

describe('ModelManifest license guard', () => {
  it('accepts permissive code and weight licences', () => {
    const result = validateModelManifest({
      tenantId: 'tenant-1',
      version: 'v1.0.0',
      sha256: 'a'.repeat(64),
      codeLicense: 'MIT',
      weightLicense: 'Apache-2.0',
      trainingData: 'Pilot site footage, consented, internal collection',
      thresholdsJson: { minConfidence: 0.7 },
    });

    expect(result.valid).toBe(true);
    expect(result.errors).toEqual([]);
    expect(isPermissiveLicense('MIT')).toBe(true);
  });

  it('rejects missing or non-permissive licences', () => {
    const missing = validateModelManifest({
      tenantId: 'tenant-1',
      version: 'v1.0.0',
      sha256: 'b'.repeat(64),
      codeLicense: '',
      weightLicense: 'Apache-2.0',
      trainingData: 'internal',
    });

    expect(missing.valid).toBe(false);
    expect(missing.errors).toContain('Model code license is required.');

    const nonPermissive = validateModelManifest({
      tenantId: 'tenant-1',
      version: 'v1.0.0',
      sha256: 'c'.repeat(64),
      codeLicense: 'GPL-3.0',
      weightLicense: 'Apache-2.0',
      trainingData: 'internal',
    });

    expect(nonPermissive.valid).toBe(false);
    expect(nonPermissive.errors.some((issue) => issue.includes('not permissive'))).toBe(true);
  });
});

